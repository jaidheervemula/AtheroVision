# Copy this file to .env before running the app or the tests (PowerShell: Copy-Item .env.example .env).
# Default (live) mode: the local model service started with
#   python -m uvicorn api.main:app --port 8000   (in the cardio_ai_hackathon folder)
# To point at a model service on another address, put the line in .env.local instead.
VITE_API_URL=http://localhost:8000
